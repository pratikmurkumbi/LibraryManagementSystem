# REQUIRED for a real deployment. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
LIBRARY_SECRET_KEY=replace-with-a-long-random-secret

# Set to 1 only when serving the application through HTTPS.
LIBRARY_HTTPS=0

# Optional: Twilio Verify SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: SMTP email OTP
SMTP_HOST=
smtp_port=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
