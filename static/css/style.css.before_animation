* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #1f2937;
}

.dashboard {
    width: 92%;
    max-width: 1000px;
    margin: 30px auto;
}

.dashboard h1 {
    color: #1565c0;
    margin-bottom: 10px;
}

.dashboard h2 {
    margin-bottom: 25px;
    color: #555;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    margin-top: 25px;
}

.card-link {
    text-decoration: none;
    color: inherit;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: 0.2s;
}

.card:hover {
    transform: translateY(-3px);
}

.card h3 {
    color: #1565c0;
    margin-bottom: 8px;
}

.card p {
    color: #666;
}

.login-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.login-box {
    width: 100%;
    max-width: 400px;
    background: white;
    padding: 30px;
    border-radius: 18px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.1);
}

.login-box h1 {
    text-align: center;
    color: #1565c0;
    margin-bottom: 25px;
}

label {
    display: block;
    margin-bottom: 7px;
    font-weight: bold;
}

input,
select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
    margin-bottom: 15px;
    font-size: 15px;
}

button,
.button {
    display: inline-block;
    background: #1565c0;
    color: white;
    border: none;
    padding: 11px 18px;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    font-size: 15px;
}

button:hover,
.button:hover {
    background: #0d47a1;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    margin-top: 20px;
    border-radius: 10px;
    overflow: hidden;
}

th {
    background: #1565c0;
    color: white;
    padding: 12px;
}

td {
    padding: 11px;
    border-bottom: 1px solid #ddd;
}

.logout {
    display: inline-block;
    margin-top: 30px;
    color: #d32f2f;
    text-decoration: none;
    font-weight: bold;
}

.error {
    color: #d32f2f;
    margin-bottom: 15px;
    text-align: center;
}

a {
    color: #1565c0;
}

@media (max-width: 600px) {

    .dashboard {
        width: 94%;
        margin: 20px auto;
    }

    .dashboard h1 {
        font-size: 25px;
    }

    .card {
        padding: 20px;
    }

    table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }

    .login-box {
        padding: 22px;
    }
}

.library-logo {
    font-size: 42px;
    text-align: center;
    margin-bottom: 5px;
}

.login-box h1 {
    font-size: 30px;
    margin-bottom: 5px;
}

.login-subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 25px;
}

.login-button {
    width: 100%;
    padding: 13px;
    font-size: 16px;
    margin-top: 5px;
}

.login-footer {
    text-align: center;
    color: #888;
    font-size: 13px;
    margin-top: 22px;
}

@media (max-width: 600px) {

    .login-container {
        padding: 18px;
    }

    .login-box {
        max-width: 430px;
        padding: 30px 24px;
    }

    .login-box h1 {
        font-size: 30px;
    }

    input {
        padding: 14px;
        font-size: 16px;
    }
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin: 25px 0 35px;
}

.stat-card {
    background: white;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

.stat-icon {
    font-size: 30px;
    margin-bottom: 8px;
}

.stat-card h3 {
    font-size: 28px;
    color: #1565c0;
    margin-bottom: 5px;
}

.stat-card p {
    color: #666;
}

.section-title {
    margin-top: 10px;
}

@media (max-width: 700px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .stat-card {
        padding: 16px 10px;
    }

    .stat-card h3 {
        font-size: 24px;
    }
}

.page-subtitle {
    color: #666;
    margin-bottom: 20px;
}

.search-box {
    background: white;
    padding: 18px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    margin-bottom: 25px;
}

.search-box input {
    margin-bottom: 10px;
}

.search-box button {
    width: 100%;
}

.book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
}

.book-card {
    background: white;
    padding: 22px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

.book-icon {
    font-size: 35px;
    margin-bottom: 10px;
}

.book-card h3 {
    color: #1565c0;
    margin-bottom: 15px;
}

.book-card p {
    margin: 8px 0;
    color: #555;
}

.available {
    margin-top: 15px;
    padding: 9px;
    background: #e8f5e9;
    color: #2e7d32;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
}

.unavailable {
    margin-top: 15px;
    padding: 9px;
    background: #ffebee;
    color: #c62828;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
}

.profile-card {
    background: white;
    max-width: 500px;
    padding: 25px;
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

.profile-icon {
    font-size: 50px;
    text-align: center;
    margin-bottom: 10px;
}

.profile-card h2 {
    text-align: center;
    color: #1565c0;
    margin-bottom: 20px;
}

.profile-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 14px 0;
    border-bottom: 1px solid #eee;
}

.profile-row span {
    color: #666;
    text-align: right;
}

/* =========================
   FORM UI IMPROVEMENT
   ========================= */

.dashboard .login-box {
    width: 100%;
    max-width: 650px;
    margin: 25px auto;
    padding: 32px;
    box-sizing: border-box;
}

.dashboard .login-box h1 {
    font-size: 28px;
    margin-bottom: 25px;
}

.dashboard .login-box form {
    width: 100%;
}

.dashboard .login-box label {
    margin-top: 5px;
    margin-bottom: 8px;
}

.dashboard .login-box input,
.dashboard .login-box select {
    width: 100%;
    box-sizing: border-box;
    padding: 13px;
    margin-bottom: 18px;
}

.dashboard .login-box button {
    width: 100%;
    margin-top: 5px;
    padding: 13px;
    font-size: 16px;
}

/* Remove excessive manual <br> spacing inside forms */
.dashboard .login-box br {
    display: none;
}

/* Mobile */
@media (max-width: 600px) {
    .dashboard .login-box {
        max-width: 100%;
        padding: 22px;
        margin: 15px auto;
    }

    .dashboard .login-box h1 {
        font-size: 24px;
    }
}
.table-container {
    width: 100%;
    overflow-x: auto;
    margin-top: 25px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

.table-container table {
    min-width: 850px;
    margin-top: 0;
}

.action-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
}

.action-buttons form {
    margin: 0;
}

.action-buttons button,
.action-buttons .button {
    white-space: nowrap;
}

.available {
    color: #2e7d32;
    font-weight: bold;
}

.unavailable {
    color: #d32f2f;
    font-weight: bold;
}

@media (max-width: 700px) {

    .table-container {
        margin-top: 20px;
    }

    .action-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .action-buttons .button,
    .action-buttons button {
        width: 100%;
        text-align: center;
    }
}
/* =========================
   FORM CARD
========================= */

.form-card {
    max-width: 600px;
    margin: 25px auto;
    padding: 30px;
}

.form-card label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    color: #333;
}

.form-card input,
.form-card select {
    width: 100%;
    box-sizing: border-box;
    padding: 14px;
    margin-bottom: 18px;
    border: 1px solid #ccc;
    border-radius: 9px;
    font-size: 16px;
    background: white;
}

.form-card input:focus,
.form-card select:focus {
    outline: none;
    border-color: #1565c0;
    box-shadow: 0 0 0 2px rgba(21, 101, 192, 0.12);
}

.form-card button {
    width: 100%;
    padding: 14px;
    font-size: 16px;
    margin-top: 5px;
}

@media (max-width: 600px) {

    .form-card {
        width: 100%;
        box-sizing: border-box;
        padding: 22px;
        margin-top: 20px;
    }

    .form-card input,
    .form-card select {
        font-size: 16px;
        padding: 14px;
    }
}

.book-image {
    width: 100%;
    height: 220px;
    object-fit: contain;
    border-radius: 12px;
    background: #f5f5f5;
    margin-bottom: 15px;
}

.form-card {
    max-width: 650px;
    margin: 25px auto;
}

.form-card small {
    color: #666;
    display: block;
    margin-top: -8px;
    margin-bottom: 15px;
}

.form-card button {
    width: 100%;
    margin-top: 10px;
}

@media (max-width: 600px) {
    .book-image {
        height: 200px;
    }

    .form-card {
        width: 100%;
    }
}

